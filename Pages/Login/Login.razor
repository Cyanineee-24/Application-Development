@page "/"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation

<div class="login-wrapper">
    <div class = "login-container-One">
        <div class="visual-section">
            <div class="ambient-glow"></div>
                <div class="track-wrapper">
                    <img src="images/TRACK_PATH.png" class="bg-track track-one" alt="Racetrack Background" />
                    <img src="images/TRACK_PATH.png" class="bg-track track-two" alt="Racetrack Background" />
                    <img src="images/TRACK_PATH.png" class="bg-track track-three" alt="Racetrack Background" />
                </div>
            
            <img src="images/CAR_PATH.png" class="hero-car" alt="Sports Car" />
        </div>
    </div>
    <div class="login-container-Two">
        <div class="form-card">
            <div class="brand-badge"></div>
            <h1 class="form-title">LOGIN</h1>
            
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" class="login-form">
                <DataAnnotationsValidator />
                
                <div class="input-group">
                    <InputText @bind-Value="loginModel.Username" id="username" class="custom-input" placeholder=" " />
                    <label for ="username">Username</label>
                    <span class="input-focus-border"></span>
                </div>

                <div class="input-group">
                    <InputText @bind-Value="loginModel.Password" id="password" type="password" class="custom-input" placeholder=" " />
                    <label for="password">Password</label>
                    <span class="input-focus-border"></span>
                </div>

                <button type="submit" class="btn-login">
                    <span>Login</span>
                </button>
            </EditForm>

            <div class="form-footer">
                <NavLink href="register" class="register-link">Don't have an account? <span>Register</span></NavLink>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new LoginModel();

    private void HandleLogin()
    {
        Navigation.NavigateTo("/home");
    }

    public class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}